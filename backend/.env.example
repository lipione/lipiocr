LIPIOCR_ENVIRONMENT=development
LIPIOCR_CORS_ORIGINS=http://localhost:3000
LIPIOCR_UPLOAD_DIR=storage/uploads

LIPIOCR_REPOSITORY_BACKEND=memory
DATABASE_URL=
LIPIOCR_ASYNC_JOBS_ENABLED=false

LIPIOCR_STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=lipiocr-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

LIPIOCR_OCR_PROVIDER=mock
LIPIOCR_GEMMA_ENABLED=false
LIPIOCR_GEMMA_API_BASE=http://127.0.0.1:8003/v1
LIPIOCR_GEMMA_MODEL=gemma-4-26b-4bit
LIPIOCR_GEMMA_TIMEOUT_SECONDS=45
LIPIOCR_GEMMA_MAX_TOKENS=1200
LIPIOCR_GEMMA_RETRIES=2
LIPIOCR_GEMMA_VISION_TILING_ENABLED=true
LIPIOCR_GEMMA_VISION_TILE_COUNT=4
LIPIOCR_GEMMA_VISION_TILE_OVERLAP_PX=96
LIPIOCR_GEMMA_VISION_TILE_MIN_LINES=8
LIPIOCR_GEMMA_REQUIRE_JSON=true

LIPIOCR_API_AUTH_ENABLED=false
LIPIOCR_API_KEYS=maker-demo-key:maker,checker-demo-key:checker,admin-demo-key:admin
LIPIOCR_SESSION_SECRET=lipiocr-local-session-secret
LIPIOCR_SESSION_TTL_SECONDS=43200
LIPIOCR_SESSION_COOKIE_NAME=lipiocr_session
LIPIOCR_DEFAULT_TENANT_ID=demo-institution

LIPIOCR_MAX_UPLOAD_BYTES=26214400
LIPIOCR_ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/avif,image/bmp,image/gif,image/jpeg,image/png,image/tiff,image/webp,text/plain
LIPIOCR_ALLOWED_UPLOAD_EXTENSIONS=.avif,.bmp,.gif,.jpeg,.jpg,.pdf,.png,.tif,.tiff,.txt,.webp
LIPIOCR_PREVIEW_TOKEN_SECRET=lipiocr-local-preview-secret
LIPIOCR_PREVIEW_TOKEN_TTL_SECONDS=900

LIPIOCR_TEMPLATE_STORE=
LIPIOCR_TEMPLATE_PROFILE_STORE=
LIPIOCR_LOAD_TEMPLATE_STORE=false

LIPIOCR_WEBHOOK_SECRET=lipiocr-local-webhook-secret
LIPIOCR_PUBLIC_APP_BASE_URL=http://localhost:3000
