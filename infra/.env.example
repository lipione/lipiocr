LIPIOCR_ENVIRONMENT=production
LIPIOCR_CORS_ORIGINS=http://localhost:3020

LIPIOCR_REPOSITORY_BACKEND=sql
LIPIOCR_STORAGE_BACKEND=s3
LIPIOCR_OCR_PROVIDER=gemma_vision
LIPIOCR_INSTALL_OCR_EXTRAS=false
LIPIOCR_PADDLE_LANG=en
LIPIOCR_PADDLE_MODEL_MOUNT=/data/lipivision
LIPIOCR_PADDLE_DET_MODEL_DIR=
LIPIOCR_PADDLE_REC_MODEL_DIR=
LIPIOCR_PADDLE_CLS_MODEL_DIR=
LIPIOCR_PADDLE_REC_CHAR_DICT_PATH=
LIPIOCR_LEGACY_OCR_FALLBACK_ENABLED=false

LIPIOCR_GEMMA_ENABLED=true
LIPIOCR_GEMMA_API_BASE=http://host.docker.internal:8003/v1
LIPIOCR_GEMMA_MODEL=lipione-gemma4-12b
LIPIOCR_GEMMA_TIMEOUT_SECONDS=90
LIPIOCR_GEMMA_MAX_TOKENS=4000
LIPIOCR_GEMMA_RETRIES=2
LIPIOCR_GEMMA_REQUIRE_JSON=true

LIPIOCR_API_AUTH_ENABLED=true
# Format: key:role,key2:role2. Roles: maker, checker, auditor, admin.
LIPIOCR_API_KEYS=replace-maker-key:maker,replace-checker-key:checker,replace-admin-key:admin
LIPIOCR_SESSION_SECRET=replace-with-long-random-session-secret
LIPIOCR_SESSION_TTL_SECONDS=43200
LIPIOCR_DEFAULT_TENANT_ID=demo-institution

LIPIOCR_PREVIEW_TOKEN_SECRET=replace-with-long-random-preview-token-secret
LIPIOCR_PREVIEW_TOKEN_TTL_SECONDS=900
LIPIOCR_MAX_UPLOAD_BYTES=26214400
LIPIOCR_ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png,image/tiff,image/webp
LIPIOCR_ALLOWED_UPLOAD_EXTENSIONS=.jpeg,.jpg,.pdf,.png,.tif,.tiff,.webp

LIPIOCR_WEBHOOK_SECRET=replace-with-long-random-webhook-secret
LIPIOCR_PUBLIC_APP_BASE_URL=http://localhost:3020

NEXT_PUBLIC_API_BASE_URL=auto
NEXT_PUBLIC_API_PORT=8020
NEXT_PUBLIC_BASE_PATH=
LIPIOCR_API_PORT=8020
LIPIOCR_FRONTEND_PORT=3020
LIPIOCR_MINIO_BIND=127.0.0.1

POSTGRES_DB=lipiocr
POSTGRES_USER=lipiocr
POSTGRES_PASSWORD=replace-with-strong-postgres-password

MINIO_ROOT_USER=lipiocr
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
S3_BUCKET=lipiocr-documents
